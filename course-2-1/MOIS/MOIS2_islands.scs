subject_domain_of_islands <- sc_node_struct;;
subject_domain_of_islands => nrel_main_idtf: [Предметная область островов] (*<- lang_ru;;*);;
subject_domain_of_islands => nrel_main_idtf: [Subject domain of islands] (*<- lang_en;;*);;
subject_domain_of_islands => nrel_private_subject_domain: subject_domain_countries;;
subject_domain_of_islands => nrel_private_subject_domain: subject_domain_islands;;
subject_domain_of_islands => nrel_maximum_studied_object_class: concept_island;;
subject_domain_of_islands => nrel_not_maximum_studied_object_class: concept_country;;
subject_domain_of_islands => nrel_explored_relation: nrel_belonging;;

section_subject_domain_of_islands <- non_atomic_section;;
section_subject_domain_of_islands => nrel_main_idtf: [Раздел. Предметная область островов] (*<- lang_ru;;*);;
section_subject_domain_of_islands => nrel_main_idtf: [Section. Subject domain of islands] (*<- lang_en;;*);;
section_subject_domain_of_islands => nrel_section_decomposition: section_subject_domain_of_countries;;
section_subject_domain_of_islands => nrel_section_decomposition: section_subject_domain_of_islands;;
section_subject_domain_of_islands => rrel_key_sc_element: nrel_belonging;;

nrel_belonging <- sc_node_norole_relation;;
nrel_belonging => nrel_main_idtf: [принадлежность] (*<- lang_ru;;*);;
nrel_belonging => nrel_main_idtf: [belonging] (*<- lang_en;;*);;

concept_island <- sc_node_class;;
concept_island => nrel_main_idtf: [остров] (*<- lang_ru;;*);;
concept_island => nrel_main_idtf: [island] (*<- lang_en;;*);;
concept_island => nrel_belonging: concept_country;;

concept_country <- sc_node_class;;
concept_country => nrel_main_idtf: [страна] (*<- lang_ru;;*);;
concept_country => nrel_main_idtf: [country] (*<- lang_en;;*);;
concept_country => nrel_has_ownership: concept_island;;

section_subject_domain_of_islands = [*
    subject_domain_of_islands => nrel_main_idtf:[Предметная область островов] (*<- lang_ru;;*);[Subject domain of islands](*<- lang_en;;*);
                               <- sc_node_struct;
                               -> rrel_explored_relation: nrel_belonging;
                                                          nrel_geographical_location;
                                                          nrel_population_density;
                                                          nrel_tourism;
                                                          nrel_biodiversity;
                               => nrel_private_subject_domain: subject_domain_island_geography;
                                                               subject_domain_island_population;
                                                               subject_domain_island_tourism;
                                                               subject_domain_island_biodiversity;
                               <- subject_domain;
                               -> rrel_maximum_studied_object_class: concept_island;
                               -> rrel_not_maximum_studied_object_class: concept_country;;
*];;

section_subject_domain_of_islands  => nrel_main_idtf:[Раздел. Предметная область островов] (*<- lang_ru;;*);[Section. Subject domain of islands](*<- lang_en;;*);
                                <= nrel_section_decomposition: ...
                                                            (* <-sc_node_tuple;;
                                                               -> section_subject_domain_of_island_geography;;
                                                               -> section_subject_domain_of_island_population;;
                                                               -> section_subject_domain_of_island_tourism;;
                                                               -> section_subject_domain_of_island_biodiversity;;
                                                             *);
                                -> rrel_key_sc_element: nrel_belonging;
                                                        nrel_geographical_location;
                                                        nrel_population_density;
                                                        nrel_tourism;
                                                        nrel_biodiversity;
                                <- non_atomic_section;;

nrel_geographical_location <- sc_node_norole_relation;
                               => nrel_main_idtf:[географическое положение] (*<- lang_ru;;*);[geographical location](*<- lang_en;;*);;

nrel_population_density <- sc_node_norole_relation;
              => nrel_main_idtf:[плотность населения] (*<- lang_ru;;*);[population density](*<- lang_en;;*);;

nrel_tourism <- sc_node_norole_relation;
          => nrel_main_idtf:[туризм] (*<- lang_ru;;*);[tourism](*<- lang_en;;*);;

nrel_biodiversity <- sc_node_norole_relation;
                 => nrel_main_idtf:[биоразнообразие] (*<- lang_ru;;*);[biodiversity](*<- lang_en;;*);;

section_subject_domain_of_island_geography = [**];
                               => nrel_main_idtf:[Раздел. Предметная область географии островов] (*<- lang_ru;;*);[Section. Subject domain of island geography](*<- lang_en;;*);;

section_subject_domain_of_island_population = [**];
                               => nrel_main_idtf:[Раздел. Предметная область населения островов] (*<- lang_ru;;*);[Section. Subject domain of island population](*<- lang_en;;*);;

section_subject_domain_of_island_tourism = [**];
                                => nrel_main_idtf:[Раздел. Предметная область туризма на островах] (*<- lang_ru;;*);[Section. Subject domain of island tourism](*<- lang_en;;*);;

section_subject_domain_of_island_biodiversity => nrel_main_idtf:[Раздел. Предметная область биоразнообразия островов] (*<- lang_ru;;*);[Section. Subject domain of island biodiversity](*<- lang_en;;*);
                               <- sc_node_struct;;

subject_domain_island_geography => nrel_main_idtf:[Предметная область географии островов] (*<- lang_ru;;*);[Subject domain of island geography](*<- lang_en;;*);
                        <- sc_node_struct;;

subject_domain_island_population => nrel_main_idtf:[Предметная область населения островов] (*<- lang_ru;;*);[Subject domain of island population](*<- lang_en;;*);
                        <- sc_node_struct;;

subject_domain_island_tourism => nrel_main_idtf:[Предметная область туризма на островах] (*<- lang_ru;;*);[Subject domain of island tourism](*<- lang_en;;*);
                           <- sc_node_struct;;

subject_domain_island_biodiversity => nrel_main_idtf:[Предметная область биоразнообразия островов] (*<- lang_ru;;*);[Subject domain of island biodiversity](*<- lang_en;;*);
                               <- sc_node_struct;;

concept_island <- sc_node_class;
                => nrel_main_idtf:[остров] (*<- lang_ru;;*);[island](*<- lang_en;;*);;

concept_country <- sc_node_class;
                 => nrel_main_idtf:[страна] (*<- lang_ru;;*);[country](*<- lang_en;;*);;
