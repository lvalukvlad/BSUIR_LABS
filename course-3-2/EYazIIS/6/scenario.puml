@startuml

start
:Получение входного сообщения пользователя;
:Лексико-морфологическая предобработка\n(токенизация, нормализация, лемматизация);
:Загрузка контекста текущей диалоговой сессии;

if (Экстренный сценарий?) then (Да)
  :Формирование экстренного ответа\n(рекомендация немедленного обращения,\nвызов 102);
  :Сохранение пары\n«запрос-ответ» в БД\nи обновление контекста;
  stop
else (Нет)
endif

if (Служебный интент?\nприветствие/помощь/завершение) then (Да)
  :Формирование служебного ответа;
  :Сохранение пары\n«запрос-ответ» в БД\nи обновление контекста;
  stop
else (Нет)
endif

if (Найдено соответствие\nв доменной базе знаний?) then (Да)
  :Формирование ответа\nпо правилам предметной области;
  :Сохранение пары\n«запрос-ответ» в БД\nи обновление контекста;
  stop
else (Нет)
endif

if (LLM доступна и\nвернула валидный ответ?) then (Да)
  :Формирование ответа\nна основе LLM;
  :Сохранение пары\n«запрос-ответ» в БД\nи обновление контекста;
  stop
else (Нет)
endif

if (Найдены релевантные фрагменты\nв локальном корпусе\n(TF-IDF + cosine similarity)?) then (Да)
  :Формирование ответа\nс использованием корпусных фрагментов;
  :Сохранение пары\n«запрос-ответ» в БД\nи обновление контекста;
  stop
else (Нет)
  :Формирование ответа\nо необходимости уточнения запроса;
  :Сохранение пары\n«запрос-ответ» в БД\nи обновление контекста;
  stop
endif

@enduml
