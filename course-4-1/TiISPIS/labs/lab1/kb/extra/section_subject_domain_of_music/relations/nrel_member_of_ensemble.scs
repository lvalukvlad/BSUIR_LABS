nrel_member_of_ensemble
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[участник коллектива*]
	(* <- lang_ru;; *);
	[member of ensemble*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_musician;
=> nrel_second_domain: concept_performer;
=> nrel_definitional_domain:
	..nrel_member_of_ensemble_def_domain
	(*
		<= nrel_combination: {
			concept_musician;
			concept_performer
		};;
	*);
<- rrel_key_sc_element:
	..nrel_member_of_ensemble_definition
	(*
		=> nrel_main_idtf:
			[Опр. (участник коллектива*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			..nrel_member_of_ensemble_definition_text
			(*
				-> rrel_example:
					[Участник коллектива* — бинарное ориентированное отношение между музыкантом и коллективом (группой или оркестром), в состав которого он входит.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants: {
			concept_musician;
			concept_performer
		};;
	*);;
