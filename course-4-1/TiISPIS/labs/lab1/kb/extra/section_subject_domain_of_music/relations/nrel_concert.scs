nrel_concert
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[концертное исполнение*]
	(* <- lang_ru;; *);
	[concert performance*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_musical_work;
=> nrel_second_domain: concept_concert;
=> nrel_definitional_domain:
	..nrel_concert_def_domain
	(*
		<= nrel_combination: {
			concept_musical_work;
			concept_concert
		};;
	*);
<- rrel_key_sc_element:
	..nrel_concert_definition
	(*
		=> nrel_main_idtf:
			[Опр. (концертное исполнение*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			..nrel_concert_definition_text
			(*
				-> rrel_example:
					[Концертное исполнение* — бинарное ориентированное отношение, связывающее музыкальное произведение и концерт, на котором оно исполнялось.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants: {
			concept_musical_work;
			concept_concert
		};;
	*);;
