nrel_duration
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[длительность*]
	(* <- lang_ru;; *);
	[duration*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_musical_work;
=> nrel_second_domain: concept_music;
=> nrel_definitional_domain:
	..nrel_duration_def_domain
	(*
		<= nrel_combination: {
			concept_musical_work;
			concept_music
		};;
	*);
<- rrel_key_sc_element:
	..nrel_duration_definition
	(*
		=> nrel_main_idtf:
			[Опр. (длительность*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			..nrel_duration_definition_text
			(*
				-> rrel_example:
					[Длительность* — бинарное ориентированное отношение, связывающее произведение с его типичной длительностью звучания (sc-ссылка).]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants: {
			concept_musical_work;
			concept_music
		};;
	*);;
