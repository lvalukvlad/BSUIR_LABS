nrel_included_in_album
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[входить в альбом*]
	(* <- lang_ru;; *);
	[included in album*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_song;
=> nrel_second_domain: concept_album;
=> nrel_definitional_domain:
	..nrel_included_in_album_def_domain
	(*
		<= nrel_combination: {
			concept_song;
			concept_album
		};;
	*);
<- rrel_key_sc_element:
	..nrel_included_in_album_definition
	(*
		=> nrel_main_idtf:
			[Опр. (входить в альбом*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			..nrel_included_in_album_definition_text
			(*
				-> rrel_example:
					[Входить в альбом* — бинарное ориентированное отношение между песней (треком) и альбомом, в который она входит.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants: {
			concept_song;
			concept_album
		};;
	*);;
