nrel_performed_on_instrument
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[исполняется на инструменте*]
	(* <- lang_ru;; *);
	[performed on instrument*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_musical_work;
=> nrel_second_domain: concept_musical_instrument;
=> nrel_definitional_domain:
	..nrel_performed_on_instrument_def_domain
	(*
		<= nrel_combination: {
			concept_musical_work;
			concept_musical_instrument
		};;
	*);
<- rrel_key_sc_element:
	..nrel_performed_on_instrument_definition
	(*
		=> nrel_main_idtf:
			[Опр. (исполняется на инструменте*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			..nrel_performed_on_instrument_definition_text
			(*
				-> rrel_example:
					[Исполняется на инструменте* — бинарное ориентированное отношение между произведением и инструментом, существенным для его исполнения.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants: {
			concept_musical_work;
			concept_musical_instrument
		};;
	*);;
