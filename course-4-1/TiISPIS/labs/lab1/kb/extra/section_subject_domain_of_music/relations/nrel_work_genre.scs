nrel_work_genre
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[жанр произведения*]
	(* <- lang_ru;; *);
	[genre of work*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_musical_work;
=> nrel_second_domain: concept_musical_genre;
=> nrel_definitional_domain:
	..nrel_work_genre_def_domain
	(*
		<= nrel_combination: {
			concept_musical_work;
			concept_musical_genre
		};;
	*);
<- rrel_key_sc_element:
	..nrel_work_genre_definition
	(*
		=> nrel_main_idtf:
			[Опр. (жанр произведения*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			..nrel_work_genre_definition_text
			(*
				-> rrel_example:
					[Жанр произведения* — бинарное ориентированное отношение, указывающее жанровую принадлежность произведения.]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants: {
			concept_musical_work;
			concept_musical_genre
		};;
	*);;
