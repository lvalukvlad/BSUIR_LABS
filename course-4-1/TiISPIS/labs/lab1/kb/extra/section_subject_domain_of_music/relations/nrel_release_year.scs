nrel_release_year
<- sc_node_norole_relation;
<- relation;
<- binary_relation;
<- oriented_relation;
<- antireflexive_relation;
<- asymmetric_relation;
<- antitransitive_relation;
=> nrel_main_idtf:
	[год выпуска*]
	(* <- lang_ru;; *);
	[release year*]
	(* <- lang_en;; *);
=> nrel_first_domain: concept_album;
=> nrel_second_domain: concept_music;
=> nrel_definitional_domain:
	..nrel_release_year_def_domain
	(*
		<= nrel_combination: {
			concept_album;
			concept_music
		};;
	*);
<- rrel_key_sc_element:
	..nrel_release_year_definition
	(*
		=> nrel_main_idtf:
			[Опр. (год выпуска*)]
			(* <- lang_ru;; *);;
		<- definition;;
		<= nrel_sc_text_translation:
			..nrel_release_year_definition_text
			(*
				-> rrel_example:
					[Год выпуска* — бинарное ориентированное отношение, связывающее альбом с числовым значением года издания (хранится как sc-ссылка).]
					(* <- lang_ru;; *);;
			*);;
		<= nrel_using_constants: {
			concept_album;
			concept_music
		};;
	*);;
