@startuml
digraph min_dfa {
  rankdir=LR;
  bgcolor="white";
  pad=0.25;
  nodesep=0.5;
  ranksep=0.75;
  fontname="Liberation Sans";
  node [fontname="Liberation Sans", fontsize=14, shape=circle, width=0.55, height=0.55, style=filled, fillcolor="white", color="#1B242E", fontcolor="#1B242E"];
  edge [fontname="Liberation Sans", fontsize=13, color="#1B242E"];

  start [shape=point, width=0.16, fillcolor="#1B242E", label=""];
  q4 [shape=doublecircle];

  start -> q0;
  q0 -> q1 [label="a"];
  q1 -> q2 [label="a"];
  q2 -> q3 [label="a"];
  q3 -> q2 [label="b"];
  q2 -> q4 [label="c, d"];
  q4 -> q4 [label="c, d"];
}
@enduml
